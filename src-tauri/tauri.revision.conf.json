{
  "identifier": "com.micelya.desktop.revision",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1421",
    "devUrl": "http://localhost:1421"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Micelya · revisión",
        "width": 1280,
        "height": 800,
